FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Run collector scheduler in standalone mode
CMD ["python", "-c", "import time; from collector.scheduler import ingestion_scheduler; ingestion_scheduler.start(interval_seconds=60); print('Standalone collector active'); \nwhile True: time.sleep(10)"]
