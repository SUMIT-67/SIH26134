# Application Environment Configuration
APP_NAME=AIRFARE-INDEX
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL in Docker, SQLite fallback for local standalone)
DATABASE_URL=sqlite:///./data/airfare.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/airfare_index

# Redis Cache / PubSub (Optional, falls back to in-memory broker if unreachable)
REDIS_URL=redis://localhost:6379/0
# For Redis in Docker:
# REDIS_URL=redis://cache:6379/0

# Collector Configuration
MOCK_MODE=True
SCRAPE_INTERVAL_SECONDS=60
RAW_SNAPSHOT_DIR=./data/raw_snapshots

# Statistical Parameters
Z_SCORE_SPIKE_THRESHOLD=2.5
PCT_SPIKE_THRESHOLD=0.20
OUTLIER_Z_THRESHOLD=3.0
IQR_MULTIPLIER=1.5
